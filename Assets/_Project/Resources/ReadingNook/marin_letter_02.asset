  m_Name: marin_letter_02
  m_EditorClassIdentifier: HearthboundHollow.Memory::HearthboundHollow.Memory.MarinLetterFragmentSO
  fragmentId: marin_letter_02
  title: The Borrowed Key
  warmthThreshold: 15
  letterText: "There is a crate beneath the workbench. Unremarkable.\nI wouldn\u2019t
    have looked inside if Pickle hadn\u2019t sat on it for three consecutive days,\nwhich
    for Pickle is the nearest thing to a recommendation.\n\nInside: seven memories,
    none of them listed in the Hollow\u2019s ledger.\nNone of them priced.\n\nSomeone
    brought these here and never collected them.\nOr never intended to.\n\nI put
    them back. I put them back for the same reason you put letters\nback in envelopes
    you were never meant to open.\n\nBut I noted the colours.\n\n\u2014 M"
  warmthGranted: 5
  echoConnectionId: MAR-NOTE-01
