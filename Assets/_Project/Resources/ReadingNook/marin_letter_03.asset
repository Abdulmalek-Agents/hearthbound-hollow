  m_Name: marin_letter_03
  m_EditorClassIdentifier: HearthboundHollow.Memory::HearthboundHollow.Memory.MarinLetterFragmentSO
  fragmentId: marin_letter_03
  title: The Sunday Purchase
  warmthThreshold: 30
  letterText: "I sold a memory today that I should not have sold.\n\nNot because
    the buyer was wrong to want it.\nNot because the seller was wrong to let it go.\nBut
    because when I held it in the light, I recognised\na face in it that I had seen
    in another orb entirely.\n\nThe same face. A different year. A different guilt.\n\nSomeone
    has been very careful about what they let you see.\nThey did not account for
    a Hollow-keeper who takes notes.\n\n\u2014 M"
  warmthGranted: 5
  echoConnectionId: ECHO-MARIN-01
